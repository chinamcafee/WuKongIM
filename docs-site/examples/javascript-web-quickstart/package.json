{
  "name": "@wukongim/docs-javascript-web-quickstart",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc --noEmit",
    "dev": "npm run build && node dist/server.mjs",
    "start": "node dist/server.mjs",
    "test": "tsx --test test/*.test.ts",
    "check": "npm test && npm run build",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "wukongimjssdk": "1.3.5"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "esbuild": "0.25.9",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
